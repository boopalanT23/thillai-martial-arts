# ── Thillai Martial Arts Club — Frontend Environment Variables ──
# Copy this file to .env and fill in real values before running
# `npm run dev` or building for production.

# Base URL of the Spring Boot backend API
VITE_API_URL=http://localhost:8080

# Razorpay publishable Key ID (test mode: starts with rzp_test_)
# Get this from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Google Maps JavaScript API key (only needed if you switch the
# Location page from the no-key iframe embed to @react-google-maps/api)
VITE_GOOGLE_MAPS_API_KEY=
