# ── THILLAI MARTIAL ARTS CLUB — docker-compose environment ──
# Copy to `.env` in the project root before running `docker compose up`.

# Database
DB_NAME=thillai_martial_arts
DB_PASSWORD=ChangeThisStrongPassword123!

# JWT (use a long random string in production — e.g. `openssl rand -base64 48`)
JWT_SECRET=ChangeThisToALongRandomSecretStringAtLeast32CharsLong

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Mail (Gmail App Password recommended — not your real Gmail password)
MAIL_USERNAME=hartzone1974@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Admin bootstrap account (created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisStrongAdminPassword123!

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend build-time vars
VITE_API_URL=http://localhost:8080
GOOGLE_MAPS_API_KEY=
